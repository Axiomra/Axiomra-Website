{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/contact", "destination": "/spa.html" },
    { "source": "/about", "destination": "/spa.html" },
    { "source": "/tech", "destination": "/spa.html" },
    { "source": "/faqs", "destination": "/spa.html" },
    { "source": "/portfolio", "destination": "/spa.html" },
    { "source": "/industries", "destination": "/spa.html" },
    { "source": "/industries/:slug", "destination": "/spa.html" },
    { "source": "/ai-services-and-solutions", "destination": "/spa.html" },
    { "source": "/ai-services-and-solutions/:slug", "destination": "/spa.html" },
    { "source": "/case-studies/:slug", "destination": "/spa.html" },
    { "source": "/blogs", "destination": "/spa.html" },
    { "source": "/blogs/:slug", "destination": "/spa.html" },
    { "source": "/service/nlp", "destination": "/spa.html" },
    { "source": "/admin", "destination": "/spa.html" },
    { "source": "/admin/:path*", "destination": "/spa.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-ULwqZKBqXcuHjmIThOjMtIPdX7K+GueRe29yCqBddNU='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://images.unsplash.com https://i.ytimg.com; font-src 'self'; media-src 'self'; connect-src 'self' https://axiomra-server.vercel.app https://axiomra-backend-server.onrender.com; frame-src https://www.youtube-nocookie.com https://calendar.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
