{
  "name": "axiomra-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-sitemap.mjs && node scripts/prerender.mjs && node scripts/check-csp.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "perf": "npm run build && lhci autorun",
    "perf:all": "node perf/lighthouse.mjs perf/latest && node perf/table.mjs perf/baseline/summary.json perf/latest/summary.json"
  },
  "dependencies": {
    "@react-three/fiber": "^8.16.8",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.0",
    "gsap": "^3.15.0",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.30.6",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^26.1.0",
    "lighthouse": "^12.8.2",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.39",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.6",
    "vite": "^5.3.4",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^3.2.7"
  }
}
