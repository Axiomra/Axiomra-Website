# ---------------------------------------------------------------------------
# Axiomra SPA — Apache config for Hostinger.
# Vite copies everything in public/ to dist/, so this ships with the build.
# ---------------------------------------------------------------------------

# SPA routing. Without this, a direct hit or refresh on any route other than
# "/" returns 404, because Apache looks for a directory that does not exist.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ - [L]

  # Real files and directories are served as-is; everything else is the SPA.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Compression. Brotli when the module is available, gzip otherwise; both are
# declared because shared hosting does not always expose mod_brotli.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# Caching. Vite fingerprints asset filenames, so they can be cached forever.
# index.html must never be cached, or the browser keeps loading stale chunks.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|jpe?g|png|webp|avif|gif|svg|woff2?|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Already-compressed formats: stop proxies mangling them.
  <FilesMatch "\.(woff2|mp4|webm|webp|avif)$">
    Header set Vary "Accept-Encoding"
  </FilesMatch>
</IfModule>

# Correct types for anything Hostinger may not map by default.
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
  AddType video/mp4 .mp4
</IfModule>
