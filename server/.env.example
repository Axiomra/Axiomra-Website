# Local dev only. On Vercel set these in Project Settings -> Environment Variables.
PORT=5000

# Must be a MongoDB Atlas (or other hosted) connection string in production.
# A localhost URI will never resolve from a Vercel serverless function.
MONGO_URI=mongodb://127.0.0.1:27017/axiomra

# Comma-separated list of browser origins allowed to call the API (CORS) and
# to send POST/PUT/PATCH/DELETE (CSRF check). Exact origins only: wildcards
# are rejected at startup, because any `*.vercel.app` pattern can be matched
# by a project in another Vercel account. For client previews, list the
# stable branch URLs you actually use (<project>-git-<branch>-<team>.vercel.app).
# This API's own VERCEL_URL / VERCEL_BRANCH_URL are allowed automatically.
# e.g. https://axiomra.co,https://www.axiomra.co,https://axiomra-git-staging-hamzajiis-projects.vercel.app
# CLIENT_ORIGIN is the older name and is still read when this is unset.
ALLOWED_ORIGINS=http://localhost:5173

# Signing key for the admin session JWT. Must be at least 32 characters —
# sign-in refuses to work below that, and there is deliberately no fallback.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Origin the password-reset link points at, i.e. where the admin panel is
# served. Falls back to the first non-wildcard entry in ALLOWED_ORIGINS.
# e.g. https://www.axiomra.com
ADMIN_PANEL_URL=

# Gmail account used to send contact-form notifications, plus a Google
# App Password (not the account password). Leave unset to disable email.
GMAIL=
APP_PASSWORD=

# Inbox that receives the notifications. Defaults to GMAIL when unset.
CONTACT_NOTIFY_TO=

# Shared store for rate limits and the chat spend counter (e.g. an Upstash
# Redis rediss:// URL). Required in production (NODE_ENV=production or on
# Vercel): the server refuses to start without it. Local dev falls back to memory.
REDIS_URL=

# OpenAI API key for the website chat widget ("Axiomra's Assistant").
# Leave unset to disable the assistant: /api/chat then answers 503 and the
# widget points visitors to the contact options instead.
OPENAI_API_KEY=

# Hard ceiling on the assistant's model spend per UTC day, in US dollars.
# Required whenever OPENAI_API_KEY is set. Once reached, /api/chat answers 429
# with a friendly message until midnight UTC.
CHAT_DAILY_USD_CAP=5

# Optional model override for the chat. Defaults to gpt-5-mini.
CHAT_MODEL=

# Retrieval (RAG) for the chat. Content is loaded with `npm run ingest`.
# RAG_ENABLED=false turns retrieval off; the chat then uses its static prompt.
RAG_ENABLED=true
# Chunks retrieved per question (1-20).
RAG_TOP_K=6
# Minimum Atlas vector score (0-1; Atlas reports cosine as (1+cos)/2).
RAG_MIN_SCORE=0.6
# RAG_HYBRID=true adds Atlas Search text matching via $rankFusion (slower;
# off by default). Needs the rag_chunks_text index that `npm run ingest` creates.
RAG_HYBRID=false

# Admin recovery key: required for every password change. Store it in the DB
# with `node scripts/set-recovery-key.js --from-env`. Min 20 characters, mixed
# case, a number and a symbol. Wrap it in backticks if it contains quotes.
PASS_KEY=
