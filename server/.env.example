# Local dev only. On Vercel set these in Project Settings -> Environment Variables.
PORT=5000

# Must be a MongoDB Atlas (or other hosted) connection string in production.
# A localhost URI will never resolve from a Vercel serverless function.
MONGO_URI=mongodb://127.0.0.1:27017/axiomra

# Comma-separated list of allowed browser origins. An entry may use `*` as a
# wildcard within a single hostname label, which is how Vercel preview
# deployments (whose hostnames are generated per build) get through CORS.
# e.g. https://axiomra.vercel.app,https://axiomra-*.vercel.app,https://www.axiomra.com
CLIENT_ORIGIN=http://localhost:5173

# Bearer token required by GET /api/contact, which returns submission PII.
# Leave unset to keep that endpoint disabled (it responds 503).
ADMIN_API_TOKEN=

# Gmail account used to send contact-form notifications, plus a Google
# App Password (not the account password). Leave unset to disable email.
GMAIL=
APP_PASSWORD=

# Inbox that receives the notifications. Defaults to GMAIL when unset.
CONTACT_NOTIFY_TO=
