# Dependencies
node_modules/

# Build output
client/dist/
dist/
build/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Vite / tooling caches
coverage/
test-results/
.vite/
node_modules/.vite/
*.tsbuildinfo

# Local editor/tooling settings
.claude/settings.local.json

# Video masters. Keep the ProRes source local; ship client/public/media/nlp-hero.mp4.
*.mov
*.ProRes.mp4

# Unused stock video master. Too large for git; keep it local only.
client/src/assets/agentic-ai/new/*.mp4

# Images no longer referenced by any component. Kept on disk for reference,
# out of git so they never ship to Vercel. Recoverable from history if needed.
unused-images/

# SSH material. Two ed25519 private keys were committed here once and had to be
# scrubbed from history; these patterns stop a repeat.
id_*
*.pem
*.key
*_rsa
*_ed25519
*.pub

# Reference documents (SEO reviews, briefs). Kept local, never committed.
*.pdf

# Local working plan. Kept local, never committed.
PLAN.md
